# Enterprise API Copilot — environment template.
# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env. Every value below is a
# placeholder; values marked "dev-only" must be replaced outside a laptop.

# ─── Python AI service ───────────────────────────────────────────────────────
# local | test | production. Outside local/test the service refuses to start without a
# real approval key and a platform policy decision point.
COPILOT_RUNTIME_MODE=local
# ≥32 random bytes, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`.
# Leave empty in local mode to get a random per-process key (approvals then reset on restart).
COPILOT_APPROVAL_KEY=
# Environments the copilot may target, and which of them accept writes.
COPILOT_ENVIRONMENTS=sandbox
COPILOT_WRITE_ENVIRONMENTS=sandbox

# Runtime gateway per environment (Apigee runtime proxy host or the local sandbox).
# This is the RUNTIME proxy URL — not the Apigee management API (apigee.googleapis.com).
COPILOT_GATEWAY_SANDBOX_BASE_URL=http://127.0.0.1:8090
COPILOT_GATEWAY_SANDBOX_TOKEN_URL=http://127.0.0.1:8090/oauth/token
COPILOT_GATEWAY_SANDBOX_CLIENT_ID=acme-sandbox-app
# Printed by `python -m sandbox` at start-up, or pin it with SANDBOX_CLIENT_SECRET below.
COPILOT_GATEWAY_SANDBOX_CLIENT_SECRET=
COPILOT_GATEWAY_SANDBOX_KIND=sandbox
# Allows plain HTTP + loopback for this environment only. Never set for real gateways.
COPILOT_GATEWAY_SANDBOX_INSECURE_LOCAL=true

# Example of a real Apigee X runtime environment (disabled by default):
# COPILOT_ENVIRONMENTS=sandbox,staging
# COPILOT_GATEWAY_STAGING_BASE_URL=https://api-staging.example.com
# COPILOT_GATEWAY_STAGING_TOKEN_URL=https://api-staging.example.com/oauth/token
# COPILOT_GATEWAY_STAGING_CLIENT_ID=
# COPILOT_GATEWAY_STAGING_CLIENT_SECRET=

# Local sandbox gateway (synthetic data only)
SANDBOX_CLIENT_SECRET=

# APIs (python -m ai.api platform|agent)
# HS256 key for user tokens of the LOCAL platform facade (≥32 bytes; random per process if empty).
COPILOT_PLATFORM_TOKEN_KEY=
# HS256 key shared by the platform and the agent service for service-to-service tokens.
COPILOT_SERVICE_TOKEN_KEY=
# Durable runs, single-use approvals and idempotency (SQLite; required for the agent API).
COPILOT_STATE_DB=.copilot/state.db
# Emit spans as JSON lines on the copilot.trace logger (local observability profile).
COPILOT_TRACE_JSON=0
# Synthetic dev users for /api/v1/auth/dev-token (subject:tenant:role[+role],...).
COPILOT_DEV_USERS=alice:acme:developer,priya:acme:approver,vic:acme:viewer,root:acme:admin,gina:globex:developer

# CLI
COPILOT_BACKEND_URL=http://localhost:8080

# Optional model providers (not required; the default stack is deterministic/offline).
# LLM judge (opt-in): COPILOT_JUDGE_PROVIDER=anthropic with ANTHROPIC_API_KEY set.
COPILOT_JUDGE_PROVIDER=
COPILOT_JUDGE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Platform backend (Spring Boot) ──────────────────────────────────────────
APP_ENV=local
BACKEND_PORT=8080
BACKEND_CORS_ORIGINS=http://localhost:3000
AGENT_SERVICE_URL=http://localhost:8000

# ─── PostgreSQL + pgvector ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=api_copilot
POSTGRES_USER=api_copilot
# dev-only: Compose falls back to a dev-only value when unset. Set a real secret elsewhere.
POSTGRES_PASSWORD=

# ─── Redis (only because the current backend build includes spring-data-redis) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=enterprise-api-copilot
GRAFANA_ADMIN_PASSWORD=

# ─── Tests (opt-in) ──────────────────────────────────────────────────────────
# Disposable database for pgvector SQL tests; the knowledge schema is dropped and recreated.
# COPILOT_TEST_PGURL=postgresql://api_copilot:<password>@localhost:5432/api_copilot_test
