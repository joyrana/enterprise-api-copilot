# Environment Configuration Template
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=local
APP_VERSION=0.1.0-SNAPSHOT

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
BACKEND_CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=api_copilot
POSTGRES_USER=api_copilot
POSTGRES_PASSWORD=changeme

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Apigee ───────────────────────────────────────────────────────────────────
APIGEE_BASE_URL=https://apigee.googleapis.com
APIGEE_ORG=your-apigee-org
APIGEE_ENV=sandbox
APIGEE_CLIENT_ID=
APIGEE_CLIENT_SECRET=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme-use-a-256-bit-random-string
JWT_EXPIRY_SECONDS=3600

# ─── Agent Service ────────────────────────────────────────────────────────────
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_API_KEY=

# ─── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=pgvector
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=enterprise-api-copilot
