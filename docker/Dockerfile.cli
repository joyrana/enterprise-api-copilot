# syntax=docker/dockerfile:1.9
# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Build
# ─────────────────────────────────────────────────────────────────────────────
FROM golang:1.22-alpine AS builder

WORKDIR /workspace

COPY apps/cli/go.mod apps/cli/go.sum ./
RUN go mod download

COPY apps/cli/ .

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildDate=${BUILD_DATE}" \
    -o /copilot \
    ./cmd/copilot

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Minimal runtime
# ─────────────────────────────────────────────────────────────────────────────
FROM scratch AS runtime

LABEL org.opencontainers.image.title="Enterprise API Copilot CLI"
LABEL org.opencontainers.image.description="Go CLI for Enterprise API Copilot"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# CA certificates for HTTPS
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

COPY --from=builder /copilot /copilot

USER 10001:10001

ENTRYPOINT ["/copilot"]
